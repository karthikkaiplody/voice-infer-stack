  "cards": [
    {
      "dot": "amber",
      "title": "The Stage Nobody Counts",
      "items": [
        "Silence Wait is a real phase of every turn and it computes nothing",
        "It exists so the agent will not interrupt a speaker who paused to think",
        "Raising stop_secs 0.3 s to 0.8 s cost 629 ms: about 1 ms of delay per 1 ms of timeout"
      ]
    },
    {
      "dot": "rose",
      "title": "Why You Cannot Just Lower It",
      "items": [
        "This fixture has a 260 ms clause pause inside one sentence",
        "At stop_secs 0.2 s the endpoint fires there and the agent answers a fragment",
        "End to end got worse, not better: 2233 ms at 0.2 s versus 1354 ms at 0.3 s"
      ]
    },
    {
      "dot": "emerald",
      "title": "How This Was Measured",
      "items": [
        "M4 Pro 24 GB, pipecat 1.8.1, fully local, no API keys",
        "WAV injected at 20 ms real-time cadence so the endpointer sees microphone-shaped audio",
        "Median of 4 runs per cell; overlap from span interval intersection, never duration sums"
      ]
    }
  ]
