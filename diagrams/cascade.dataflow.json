  "cards": [
    {
      "dot": "emerald",
      "title": "What Overlaps",
      "items": [
        "LLM emits sentence chunks, so TTS starts before generation ends",
        "Measured LLM/TTS span intersection: 292 ms on this fixture",
        "Durations sum to 1759 ms; their union is 1467 ms. The gap is the win"
      ]
    },
    {
      "dot": "rose",
      "title": "What Cannot Overlap",
      "items": [
        "Local Whisper is segmented: no partials while the user is speaking",
        "The whole transcription is paid serially, on every single turn",
        "Streaming hosted STT is what removes this bar. That is what you buy"
      ]
    },
    {
      "dot": "amber",
      "title": "The Stage With No Compute",
      "items": [
        "VAD waits stop_secs of silence before declaring the turn over",
